# Stripe Configuration
# Get these from your Stripe Dashboard (https://dashboard.stripe.com/apikeys)
# IMPORTANT: Use Replit Secrets for production - NEVER commit these keys to git!
TESTING_STRIPE_SECRET_KEY=sk_test_your_test_key_here
TESTING_VITE_STRIPE_PUBLIC_KEY=pk_test_your_test_public_key_here
STRIPE_SECRET_KEY_LIVE=sk_live_your_live_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
USE_LIVE_STRIPE=false

# Twilio Configuration
# Get these from your Twilio Console (https://console.twilio.com/)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Twilio Phone Provisioning
# Set to 'true' to enable automatic phone number purchasing during signup
# Set to 'false' to only reuse existing phone numbers (no purchasing)
ENABLE_LIVE_TWILIO_PROVISIONING=false
# Optional: Disable phone number buying entirely (even if ENABLE_LIVE_TWILIO_PROVISIONING is true)
# DISABLE_PHONE_NUMBER_BUYING=false

# OpenAI Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# ElevenLabs Configuration (for voice synthesis)
# Get your API key from https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: ElevenLabs Voice IDs (defaults provided, customize if needed)
# Get voice IDs from https://elevenlabs.io/voice-library
# ELEVENLABS_VOICE_WARM=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_VOICE_PROFESSIONAL=pNInz6obpgDQGcFmaJgB
# ELEVENLABS_VOICE_FRIENDLY=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_VOICE_AUTHORITATIVE=ErXwobaYiN019PkySvjV
# ELEVENLABS_VOICE_CASUAL=VR6AewLTigWG4xSOukaG
# ELEVENLABS_VOICE_DEFAULT=pNInz6obpgDQGcFmaJgB

# Google OAuth Configuration (for Google Calendar integration)
# Get these from Google Cloud Console (https://console.cloud.google.com/)
# IMPORTANT: Use Replit Secrets for production - NEVER commit these to git!
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_client_secret_here

# Flask Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True

# Optional: For production deployment
# FLASK_ENV=production
# FLASK_DEBUG=False

# Production Domain Configuration
PRODUCTION_URL=https://voicebot.one
REPLIT_DOMAINS=voicebot.one
# n8n automation webhook (restaurant ordering / reservation workflows)
N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/webhook_entry
